datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

/// Where a one-time code is, as far as WhatsApp has told us. "No WhatsApp" arrives late, by webhook.
enum OtpDelivery {
  PENDING
  SENT
  DELIVERED
  WHATSAPP_UNAVAILABLE
  FAILED
}

enum ConsentKind {
  TERMS
  HEALTH_DATA
}

enum ProcessingStatus {
  UPLOADED
  EXTRACTING
  READY_FOR_REVIEW
  CONFIRMED
  FAILED
}

/// UPLOAD: a file the patient uploaded. REPORT: a PDF the server generated from verified records.
enum DocumentKind {
  UPLOAD
  REPORT
}

enum UploadIntentStatus {
  PENDING
  VERIFYING
  VERIFIED
  REJECTED
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

enum RecurrenceType {
  DAILY
  MULTIPLE_DAILY
  SPECIFIC_WEEKDAYS
  EVERY_N_DAYS
}

enum DoseStatus {
  PENDING
  TAKEN
  SKIPPED
  SNOOZED
  MISSED
}

/// Why the patient skipped a dose, chosen from a fixed list so it never lives in free text.
enum SkipReason {
  FELT_UNWELL
  DOCTOR_ADVISED
  RAN_OUT
  SIDE_EFFECTS
  OTHER
}

enum MedicationStatus {
  INACTIVE
  ACTIVE
  PAUSED
  COMPLETED
  DISCONTINUED
}

model User {
  id                    String       @id @default(uuid()) @db.Uuid
  /// Login email of the older email accounts. Phone accounts have none (their optional email is
  /// PatientProfile.contactEmail, which is never a login).
  email                 String?      @unique
  /// E.164, for example +919876543210. Set only once a code sent to it was verified.
  phoneE164             String?      @unique @map("phone_e164")
  phoneVerifiedAt       DateTime?    @map("phone_verified_at")
  /// Last sign-in or refresh. Drives the 90-day rule for new devices (P2).
  lastActiveAt          DateTime?    @map("last_active_at")
  /// Keyed hash (HMAC-SHA256) of the recovery code (P3). The code itself is shown once and never stored.
  recoveryCodeHmac      String?      @map("recovery_code_hmac")
  recoveryCodeCreatedAt DateTime?    @map("recovery_code_created_at")
  passwordHash          String?      @map("password_hash")
  passwordChangedAt     DateTime?    @map("password_changed_at")
  authProvider          AuthProvider @default(EMAIL) @map("auth_provider")
  isVerified            Boolean      @default(false) @map("is_verified")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  patientProfile          PatientProfile?
  confirmedPrescriptions  Prescription[]           @relation("ConfirmedPrescriptions")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  devices                 Device[]
  consents                ConsentRecord[]
  secondFactorChallenges  SecondFactorChallenge[]

  @@map("users")
}

model PatientProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  fullName               String    @map("full_name")
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  gender                 String?
  /// Free text, only when the patient chose to self-describe.
  genderSelfDescription  String?   @map("gender_self_description")
  /// Optional contact email from S03. Not a login, not unique.
  contactEmail           String?   @map("contact_email")
  /// Set when S03 (name, date of birth, gender, health-data consent) is complete.
  profileCompletedAt     DateTime? @map("profile_completed_at")
  bloodGroup             String?   @map("blood_group")
  isPrimaryAccountHolder Boolean   @default(true) @map("is_primary_account_holder")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPreferences UserPreferences?
  documents       Document[]
  uploadIntents   UploadIntent[]
  extractionJobs  ExtractionJob[]
  prescriptions   Prescription[]
  timelineEvents  TimelineEvent[]
  medications     Medication[]
  doseLogs        DoseLog[]

  @@map("patient_profiles")
}

model UserPreferences {
  id                   String   @id @default(uuid()) @db.Uuid
  patientProfileId     String   @unique @map("patient_profile_id") @db.Uuid
  preferredTimezone    String   @default("Asia/Kolkata") @map("preferred_timezone")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  dailySummaryTime     String?  @map("daily_summary_time")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Document {
  id               String           @id @default(uuid()) @db.Uuid
  patientProfileId String           @map("patient_profile_id") @db.Uuid
  storageKey       String           @unique @map("storage_key")
  originalFilename String           @map("original_filename")
  mimeType         String           @map("mime_type")
  fileSizeBytes    Int              @map("file_size_bytes")
  sha256Checksum   String           @map("sha256_checksum")
  status           ProcessingStatus @default(UPLOADED)
  kind             DocumentKind     @default(UPLOAD)
  pageCount        Int?             @map("page_count")
  imageWidth       Int?             @map("image_width")
  imageHeight      Int?             @map("image_height")
  uploadedAt       DateTime         @default(now()) @map("uploaded_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  patientProfile    PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  extractionJobs    ExtractionJob[]
  prescriptions     Prescription[]
  prescriptionItems PrescriptionItem[]
  timelineEvents    TimelineEvent[]
  medications       Medication[]

  @@index([patientProfileId])
  @@map("documents")
}

model UploadIntent {
  id                 String             @id @default(uuid()) @db.Uuid
  storageKey         String             @unique @map("storage_key")
  patientProfileId   String             @map("patient_profile_id") @db.Uuid
  originalFilename   String             @map("original_filename")
  mimeType           String             @map("mime_type")
  expectedSizeBytes  Int                @map("expected_size_bytes")
  expiresAt          DateTime           @map("expires_at")
  consumed           Boolean            @default(false)
  status             UploadIntentStatus @default(PENDING)
  rejectionReason    String?            @map("rejection_reason")
  verifyingStartedAt DateTime?          @map("verifying_started_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId])
  @@map("upload_intents")
}

model ExtractionJob {
  id               String    @id @default(uuid()) @db.Uuid
  patientProfileId String    @map("patient_profile_id") @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  idempotencyKey   String    @map("idempotency_key")
  status           JobStatus @default(QUEUED)
  retryCount       Int       @default(0) @map("retry_count")
  maxRetries       Int       @default(3) @map("max_retries")
  providerName     String    @map("provider_name")
  extractedPayload Json?     @map("extracted_payload")
  errorMessage     String?   @map("error_message")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  prescription   Prescription?

  @@unique([patientProfileId, idempotencyKey])
  @@index([patientProfileId])
  @@index([documentId])
  @@index([status])
  @@map("extraction_jobs")
}

model Prescription {
  id                 String       @id @default(uuid()) @db.Uuid
  patientProfileId   String       @map("patient_profile_id") @db.Uuid
  documentId         String       @map("document_id") @db.Uuid
  jobId              String       @unique @map("job_id") @db.Uuid
  prescriptionDate   DateTime?    @map("prescription_date") @db.Date
  dateIsUncertain    Boolean      @default(false) @map("date_is_uncertain")
  doctorName         String?      @map("doctor_name")
  clinicHospitalName String?      @map("clinic_hospital_name")
  diagnosis          String?
  reviewStatus       ReviewStatus @default(CONFIRMED) @map("review_status")
  confirmedAt        DateTime     @default(now()) @map("confirmed_at")
  confirmedByUserId  String       @map("confirmed_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  patientProfile  PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  document        Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  job             ExtractionJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  confirmedByUser User               @relation("ConfirmedPrescriptions", fields: [confirmedByUserId], references: [id])
  items           PrescriptionItem[]
  timelineEvents  TimelineEvent[]
  medications     Medication[]

  @@index([patientProfileId])
  @@index([documentId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                     String   @id @default(uuid()) @db.Uuid
  prescriptionId         String   @map("prescription_id") @db.Uuid
  nameAsWritten          String   @map("name_as_written")
  normalizedMedicineName String?  @map("normalized_medicine_name")
  strength               String?
  dosageForm             String   @map("dosage_form")
  frequencyText          String?  @map("frequency_text")
  durationText           String?  @map("duration_text")
  route                  String   @default("ORAL")
  instructions           String?
  isActiveMedication     Boolean  @default(false) @map("is_active_medication")
  sourceDocumentId       String   @map("source_document_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  sourceDocument Document     @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  medication     Medication?

  @@index([prescriptionId])
  @@index([sourceDocumentId])
  @@map("prescription_items")
}

model TimelineEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  patientProfileId     String   @map("patient_profile_id") @db.Uuid
  eventType            String   @default("PRESCRIPTION_RECORDED") @map("event_type")
  eventDate            DateTime @map("event_date") @db.Date
  dateIsUncertain      Boolean  @default(false) @map("date_is_uncertain")
  datePrecision        String   @default("EXACT") @map("date_precision")
  title                String
  summary              String
  sourceDocumentId     String   @map("source_document_id") @db.Uuid
  sourcePrescriptionId String?  @map("source_prescription_id") @db.Uuid
  isVerified           Boolean  @default(true) @map("is_verified")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  patientProfile     PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  sourceDocument     Document       @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourcePrescription Prescription?  @relation(fields: [sourcePrescriptionId], references: [id], onDelete: SetNull)

  @@index([patientProfileId])
  @@index([eventDate])
  @@map("timeline_events")
}

model Medication {
  id                     String           @id @default(uuid()) @db.Uuid
  patientProfileId       String           @map("patient_profile_id") @db.Uuid
  prescriptionItemId     String?          @unique @map("prescription_item_id") @db.Uuid
  prescriptionId         String?          @map("prescription_id") @db.Uuid
  sourceDocumentId       String?          @map("source_document_id") @db.Uuid
  nameAsWritten          String           @map("name_as_written")
  normalizedMedicineName String?          @map("normalized_medicine_name")
  strength               String?
  dosageForm             String           @map("dosage_form")
  route                  String           @default("ORAL")
  prescribedInstructions String?          @map("prescribed_instructions")
  status                 MedicationStatus @default(INACTIVE)
  startDate              DateTime?        @map("start_date") @db.Date
  endDate                DateTime?        @map("end_date") @db.Date
  reminderTimes          Json?            @map("reminder_times")
  notes                  String?
  discontinuedReason     String?          @map("discontinued_reason")
  discontinuedAt         DateTime?        @map("discontinued_at")
  completedAt            DateTime?        @map("completed_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  prescription     Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  sourceDocument   Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  doseLogs         DoseLog[]

  @@index([patientProfileId])
  @@index([status])
  @@map("medications")
}

model DoseLog {
  id               String      @id @default(uuid()) @db.Uuid
  medicationId     String      @map("medication_id") @db.Uuid
  patientProfileId String      @map("patient_profile_id") @db.Uuid
  scheduledTime    DateTime    @map("scheduled_time")
  status           DoseStatus  @default(PENDING)
  actionTime       DateTime?   @map("action_time")
  snoozeMinutes    Int?        @map("snooze_minutes")
  skipReason       SkipReason? @map("skip_reason")
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  medication     Medication     @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledTime])
  @@index([patientProfileId, scheduledTime])
  @@map("dose_logs")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  /// Phone sessions only: the signed-in device. Email sessions have none.
  deviceId  String?   @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

/// One WhatsApp code sent to a number. Phone numbers appear only as keyed hashes in the lookup and
/// rate-limit columns; phone_e164 is kept so the account can be created at verify, and rows are
/// deleted a day after they were made.
model OtpRequest {
  id                String      @id @default(uuid()) @db.Uuid
  phoneHmac         String      @map("phone_hmac")
  phoneE164         String      @map("phone_e164")
  codeHmac          String      @map("code_hmac")
  installIdHmac     String      @map("install_id_hmac")
  ipHmac            String      @map("ip_hmac")
  termsVersion      String      @map("terms_version")
  expiresAt         DateTime    @map("expires_at")
  wrongAttempts     Int         @default(0) @map("wrong_attempts")
  consumedAt        DateTime?   @map("consumed_at")
  cancelledAt       DateTime?   @map("cancelled_at")
  delivery          OtpDelivery @default(PENDING)
  providerMessageId String?     @unique @map("provider_message_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@index([phoneHmac, createdAt])
  @@index([installIdHmac, createdAt])
  @@index([ipHmac, createdAt])
  @@index([createdAt])
  @@map("otp_requests")
}

/// A phone the user signed in on. installIdHmac is a keyed hash of the app's install id.
model Device {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  installIdHmac String    @map("install_id_hmac")
  name          String
  platform      String
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([userId, installIdHmac])
  @@map("devices")
}

/// What the patient agreed to, which version, and when. Rows are only ever added.
model ConsentRecord {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  kind       ConsentKind
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consent_records")
}

/// A code was right, but the device is new and the account has a recovery code (P2). The token
/// proves the code step; the recovery code completes the sign-in.
model SecondFactorChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  installIdHmac  String    @map("install_id_hmac")
  deviceName     String    @map("device_name")
  devicePlatform String    @map("device_platform")
  wrongAttempts  Int       @default(0) @map("wrong_attempts")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("second_factor_challenges")
}

// Audit trail: IDs, action codes and timestamps only (no PHI, no IP, no free text).
// user_id deliberately has no foreign key so the record survives account deletion.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_events")
}
