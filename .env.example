# My Health App — Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://healthuser:healthpassword@localhost:5432/myhealthapp_dev?schema=public"

# Authentication Adapter
AUTH_PROVIDER="mock" # Options: mock | supabase | node-internal
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Private Object Storage (S3 / MinIO)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="myhealthapp-documents"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadminpassword"
STORAGE_USE_SSL="false"

# Client URL (for CORS)
CLIENT_URL="http://localhost:8081"
