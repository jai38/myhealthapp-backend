# My Health App — Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database (PostgreSQL)
# Local Docker development:
DATABASE_URL="postgresql://healthuser:healthpassword@localhost:5432/myhealthapp_dev?schema=public"

# Supabase Production / Beta Deployment:
# (From Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Authentication Adapter
AUTH_PROVIDER="node-internal" # Options: mock | supabase | node-internal
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-min-32-chars-long" # In prod, use 32+ character random secret
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Storage Options:
# Option A: Zero-cost Beta Ephemeral Storage (No AWS/S3 setup needed)
STORAGE_PROVIDER="memory"
ALLOW_EPHEMERAL_STORAGE="true"

# Option B: Local MinIO (docker-compose)
# STORAGE_PROVIDER="s3"
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="myhealthapp-documents"
# STORAGE_ACCESS_KEY="minioadmin"
# STORAGE_SECRET_KEY="minioadminpassword"
# STORAGE_USE_SSL="false"

# Option C: Supabase Storage / Cloudflare R2 (Free tier S3 compatible)
# STORAGE_PROVIDER="s3"
# STORAGE_ENDPOINT="https://[PROJECT_REF].supabase.co/storage/v1/s3"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="myhealthapp-documents"
# STORAGE_ACCESS_KEY="[SUPABASE_S3_ACCESS_KEY]"
# STORAGE_SECRET_KEY="[SUPABASE_S3_SECRET_KEY]"
# STORAGE_USE_SSL="true"

# Client URL (for CORS)
CLIENT_URL="*"
